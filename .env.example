# UniExamAI — Environment Variables
# Copy this to .env and fill in values. NEVER commit .env to git.

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Auth
JWT_SECRET=replace_with_long_random_string_min_64_chars

# AI Model — currently using Gemini (free tier)
# Get yours free at aistudio.google.com — no card required
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET — leave commented out until KYC is done and you
# set up a real webhook in the Razorpay dashboard. Nothing breaks without it.
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Database (Supabase) — get these from Project Settings → API
# ⚠️ SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — server-side
# only, NEVER send this to a browser/frontend.
SUPABASE_URL=https://[project].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyxxxxxxxxxxxxxx

# Redis (Upstash — for rate limiting and cache)
UPSTASH_REDIS_REST_URL=https://[instance].upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx
