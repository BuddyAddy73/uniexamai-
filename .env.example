# UniExamAI — Environment Variables
# Copy this to .env and fill in values. NEVER commit .env to git.

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Auth
JWT_SECRET=replace_with_long_random_string_min_64_chars

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
SUPABASE_URL=https://[project].supabase.co
SUPABASE_ANON_KEY=eyxxxxxxxxxxxxxx

# Redis (Upstash — for rate limiting and cache)
UPSTASH_REDIS_REST_URL=https://[instance].upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx
