# ════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES — NEVER COMMIT THESE
# This is the single most important section in this file.
# .env contains your real API keys, JWT secret, DB credentials.
# If this repo ever goes public, .env must never have been committed —
# not even once, not even in an old commit (git history is forever).
# ════════════════════════════════════════════════════
.env
.env.local
.env.production
.env.development
.env.*.local

# ════════════════════════════════════════════════════
# DEPENDENCIES
# ════════════════════════════════════════════════════
node_modules/
.npm

# ════════════════════════════════════════════════════
# CREDENTIAL / KEY FILES — extra safety net
# In case a service account key or certificate ever lands here by accident
# ════════════════════════════════════════════════════
*.pem
*.key
*.p12
*.cert
serviceAccountKey.json
firebase-adminsdk*.json
credentials.json

# ════════════════════════════════════════════════════
# LOGS
# ════════════════════════════════════════════════════
*.log
npm-debug.log*
logs/

# ════════════════════════════════════════════════════
# OS / EDITOR FILES
# ════════════════════════════════════════════════════
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ════════════════════════════════════════════════════
# BUILD / TEMP
# ════════════════════════════════════════════════════
dist/
build/
.cache/
*.tmp

# ════════════════════════════════════════════════════
# DATA — pending syllabus review queue (internal use only)
# This file is generated by syllabusDiffChecker.js and contains
# unreviewed scraped content — keep it out of version history
# until it's actually reviewed and merged manually.
# ════════════════════════════════════════════════════
data/processed/pending_syllabus_updates.json
